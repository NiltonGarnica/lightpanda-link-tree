# Conexion con Lightpanda (Docker Compose usa el nombre del servicio)
LIGHTPANDA_WS_URL=ws://localhost:9222/
LIGHTPANDA_HTTP_URL=http://localhost:9222

# Limites del recorrido
MAX_LINKS=500
MAX_CONCURRENCY=4
PAGE_TIMEOUT_SECONDS=15
CRAWL_TIMEOUT_SECONDS=120
TREE_CACHE_SIZE=100

# Solo para pruebas: permite recorrer localhost y redes privadas
ALLOW_PRIVATE_NETWORKS=false
