  "cards": [
    {
      "dot": "cyan",
      "title": "Qué se repite",
      "items": [
        "El bloque central se repite por cada página de los niveles 0, 1 y 2",
        "La revisión de peticiones se repite por cada petición de la página"
      ]
    },
    {
      "dot": "rose",
      "title": "Token",
      "items": [
        "LightpandaClient lo añade petición por petición",
        "Scripts externos y redirecciones a otros dominios no lo reciben"
      ]
    },
    {
      "dot": "amber",
      "title": "Si algo falla",
      "items": [
        "Datos inválidos: 422",
        "URL interna: 400",
        "Lightpanda sin conexión: 503",
        "Una página con error se marca en su nodo y el recorrido continúa"
      ]
    }
  ]
